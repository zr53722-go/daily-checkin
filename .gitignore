# ============================================================================
#  .gitignore —— 确保令牌与日志不会被误提交
# ============================================================================

# 同步日志（含时间与令牌有效期信息）
sync-token.log
*.log

# 临时文件
*.tmp
.tmp/
tmp/

# PowerShell
*.ps1.bak

# 如果本地测试时把令牌写进了文件，务必排除
secrets.txt
token.txt
*.token

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器
.vs/
.vscode/
.idea/
